#
# ESP32-C3-SmartHome-Actuator  ——  BLE + WS2812 (btsh_light) 配置
#
# 板子: DogKing ESP32-C3-SmartHome-Actuator
#   模组 : ESP32-C3-WROOM-02-N4
#   LED  : 5 x WS2812B (LED3~LED7)，数据线 GPIO4，SPI2 MOSI 模拟时序
#   控制台: UART0 = GPIO20/GPIO21（板上 H1 排针）
#   BLE  : ESP32-C3 内置控制器 + NuttX BT host + btsh_light GATT 服务
#
# 用法:
#   cd nuttx
#   ./tools/configure.sh esp32c3-generic:btlight
#   make -j$(nproc)
#
# 这是 defconfig（最小集），make olddefconfig 会自动补齐依赖项。
#

# 开机自动广播 BLE（无需串口敲 btsh_light start）
CONFIG_ESP32C3_GENERIC_BTSH_AUTOSTART=y
CONFIG_ESP32C3_GENERIC_BTSH_AUTOSTART_DELAY=3000

# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ARCH="risc-v"
CONFIG_ARCH_BOARD="esp32c3-generic"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32C3_GENERIC=y
CONFIG_ARCH_CHIP="esp32c3"
CONFIG_ARCH_CHIP_ESP32C3_GENERIC=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_RISCV=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LOOPSPERMSEC=15000
CONFIG_BTSAK=y
CONFIG_BTSH_LIGHT=y
CONFIG_BTSH_LIGHT_LED_COUNT=5
CONFIG_BUILTIN=y
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_ESPRESSIF_BLE=y
CONFIG_ESPRESSIF_SPI=y
CONFIG_ESPRESSIF_SPI2=y
CONFIG_ESPRESSIF_SPI2_MOSIPIN=4
CONFIG_ESPRESSIF_USBSERIAL=y
CONFIG_ESP32C3_GENERIC_WS2812=y
CONFIG_ESP32C3_GENERIC_WS2812_NLEDS=5
CONFIG_FS_PROCFS=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_INTELHEX_BINARY=y
CONFIG_LIBC_PERROR_STDOUT=y
CONFIG_LIBC_STRERROR=y
CONFIG_LINE_MAX=64
CONFIG_NAME_MAX=48
CONFIG_NETDEV_LATEINIT=y
CONFIG_NET_BLUETOOTH=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK=6
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_DISABLE_DATE=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_NSH_STRERROR=y
CONFIG_PREALLOC_MQ_MSGS=32
CONFIG_PREALLOC_TIMERS=0
CONFIG_ONESHOT_COUNT=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RR_INTERVAL=200
CONFIG_RTC_ALARM=y
CONFIG_SCHED_WAITPID=y
CONFIG_SIG_DEFAULT=y
CONFIG_SPI=y
CONFIG_SPI_DRIVER=y
CONFIG_START_DAY=19
CONFIG_START_MONTH=10
CONFIG_START_YEAR=2026
CONFIG_SYSTEM_NSH=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_BLUETOOTH=y
CONFIG_WIRELESS_BLUETOOTH_HOST=y
CONFIG_WS2812=y
CONFIG_WS2812_FREQUENCY=8000000
CONFIG_WS2812_LED_COUNT=5
CONFIG_SYSLOG_CONSOLE=y
CONFIG_BLUETOOTH_CNTRL_HOST_FLOW_DISABLE=y
CONFIG_DEVICE_LOCAL_NAME="BTSH-LIGHT"
CONFIG_DEVICE_NAME="BTSH-LIGHT"
CONFIG_BLUETOOTH_MAX_CONN=8
